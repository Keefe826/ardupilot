MCU STM32H7xx STM32H743xx

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
APJ_BOARD_ID 1401

# --- Clock Configuration (25 MHz HSE -> 400 MHz SYSCLK) ---
OSCILLATOR_HZ 25000000
define STM32_PLL1_DIVM_VALUE 5
define STM32_PLL1_DIVN_VALUE 160
define STM32_PLL1_DIVP_VALUE 2
define STM32_PLL1_VCI_RANGE 2

define STM32_ST_USE_TIMER 5

# --- Storage (RAM Mode) ---
define HAL_STORAGE_SIZE 16384

# --- MicroSD Filesystem ---
define HAL_OS_FATFS_IO 1

# --- USB Configuration ---
USB_VENDOR 0x1209
USB_PRODUCT 0x5741
USB_STRING_MANUFACTURER "Trident"
USB_STRING_PRODUCT "Trident H743"

# --- Serial Ports ---
SERIAL_ORDER OTG1 USART2 USART3 UART8

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# GPS UART (USART3)
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# Carrier Board Link (UART8)
PE1 UART8_TX UART8
PE0 UART8_RX UART8

# Telemetry Port (USART2)
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# --- SPI Buses & Triple LSM6DSV IMUs ---
PB3 SPI1_SCK SPI1
PB4 SPI1_MISO SPI1
PB5 SPI1_MOSI SPI1
PG6 IMU2_CS CS

PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PG8 IMU1_CS CS

PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PG5 IMU3_CS CS

SPIDEV imu1 SPI2 DEVID1 IMU1_CS MODE0 10*MHZ 10*MHZ
SPIDEV imu2 SPI1 DEVID1 IMU2_CS MODE0 10*MHZ 10*MHZ
SPIDEV imu3 SPI4 DEVID1 IMU3_CS MODE0 10*MHZ 10*MHZ

define HAL_INS_PROBE1 ADD_BACKEND(AP_InertialSensor_LSM6DSV::probe(*this, hal.spi->get_device("imu1")))
define HAL_INS_PROBE2 ADD_BACKEND(AP_InertialSensor_LSM6DSV::probe(*this, hal.spi->get_device("imu2")))
define HAL_INS_PROBE3 ADD_BACKEND(AP_InertialSensor_LSM6DSV::probe(*this, hal.spi->get_device("imu3")))
define HAL_INS_PROBE_LIST HAL_INS_PROBE1; HAL_INS_PROBE2; HAL_INS_PROBE3

# --- I2C Buses & Sensor Pinout ---
PB6 I2C1_SCL I2C1 PULLUP
PB7 I2C1_SDA I2C1 PULLUP

PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2

PF14 I2C4_SCL I2C4
PF15 I2C4_SDA I2C4

I2C_ORDER I2C1 I2C2 I2C4

# Bus 0 = External (GPS/Mag), Bus 1 & 2 = Internal
define HAL_I2C_INTERNAL_MASK 6

# Dual Barometers on Bus 2 (I2C4)
BARO BMP388 I2C:2:0x77
BARO BMP388 I2C:2:0x76
BARO LPS2XH I2C:2:0x5C
BARO LPS2XH I2C:2:0x5D

# --- External Compass Registration ---
# Disable buggy upstream auto-probe loop (bypasses line 1209 compilation error)
define AP_COMPASS_IST8310_EXTERNAL_BUS_PROBING_ENABLED 0
define AP_COMPASS_IST8310_INTERNAL_BUS_PROBING_ENABLED 0
define AP_COMPASS_IST8310_ENABLED 1

# Register direct probes on Bus 0 (I2C1)
COMPASS IST8310 I2C:0:0x0C true ROTATION_NONE
COMPASS IST8310 I2C:0:0x0E true ROTATION_NONE

# --- Analog Monitoring ---
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PA4 BATT_CURRENT_SENS ADC1 SCALE(1)

# --- MicroSD Card Logging (SDMMC1 4-bit) ---
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# --- Status Red LED ---
PG1 LED_RED OUTPUT HIGH GPIO(0)
define HAL_LED_ON 1

# --- PWM Control Outputs ---
PE11 TIM1_CH2 TIM1 PWM(1) GPIO(50)
PE13 TIM1_CH3 TIM1 PWM(2) GPIO(51)
PE14 TIM1_CH4 TIM1 PWM(3) GPIO(52)

PD12 TIM4_CH1 TIM4 PWM(4) GPIO(53)
PD13 TIM4_CH2 TIM4 PWM(5) GPIO(54)
PD14 TIM4_CH3 TIM4 PWM(6) GPIO(55)
PD15 TIM4_CH4 TIM4 PWM(7) GPIO(56)

PC6 TIM8_CH1 TIM8 PWM(8) GPIO(57)
PC7 TIM8_CH2 TIM8 PWM(9) GPIO(58)

# --- CAN Bus ---
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1

# --- DMA & System Configuration ---
DMA_PRIORITY SDMMC* ADC* SPI* USART* UART*
define HAL_WITH_IO_MCU 0