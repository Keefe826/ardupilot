# Telemetry 2 on USART2 (Carrier H7)
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 115

# GPS 2 on USART3 (SERIAL2 @ 38400 NMEA, Carrier H5)
SERIAL2_PROTOCOL 5
SERIAL2_BAUD 38
GPS1_TYPE 5

# Enable MicroSD File Logging
LOG_BACKEND_TYPE 1

# Carrier F411 link quiet until F411 firmware protocol is enabled
SERIAL3_PROTOCOL -1

# Carrier H3 Telemetry 1 (UART7), H4 GPS 1 (USART6), H2 RC Input (UART4)
SERIAL4_PROTOCOL 2
SERIAL4_BAUD 57
SERIAL5_PROTOCOL 5
SERIAL5_BAUD 38
SERIAL6_PROTOCOL 23

# Onboard WS2812B RGB LED on PA5 (PWM14 -> NeoPixel1)
SERVO14_FUNCTION 120
NTF_LED_LEN 1

BATT_MONITOR 0

# --- Trident Custom Tandem Ducted Tilt-VTOL (BWB) ---
# Frame & Tiltrotor (Q_FRAME_CLASS=18: TridentTandem)
Q_ENABLE 1
Q_FRAME_CLASS 18
Q_TILT_ENABLE 1
Q_TILT_MASK 2
Q_TILT_TYPE 0
Q_TILT_MAX 45
Q_TILT_RATE_UP 40
Q_TILT_RATE_DN 40

# Option-B Rear Tilt Forward Vectoring in PosCtrl VTOL modes (QLOITER/QRTL/AUTO)
Q_FWD_THR_USE 1
Q_FWD_THR_GAIN 4.4

# Tandem VTOL Balance & Vane Defaults (MTOW 2.2kg: 7" ESC1 ~77% lift, 6" ESC2 ~23% lift)
Q_M_THST_HOVER 0.50
Q_M_TR_THR_F 1.00
Q_M_TR_THR_R 0.66
Q_M_TR_PTC_G 0.50
Q_M_TR_ROL_G 1.00
Q_M_TR_YAW_G 1.00
Q_M_TR_YAW_T 0.00
Q_M_TR_TLT_P 0.00
Q_M_TR_TLT_M 15.0
Q_M_TR_V_MIN 0.35

# DShot300 + Bi-directional DShot (14-pole motors on SERVO8/ESC1 & SERVO9/ESC2 -> bitmask 384)
Q_M_PWM_TYPE 5
Q_M_SAFE_DISARM 0
SERVO_BLH_MASK 384
SERVO_BLH_BDMASK 384
SERVO_BLH_POLES 14

# Carrier Board Servo / ESC Pin Functions
SERVO1_FUNCTION 0
SERVO2_FUNCTION 0
SERVO3_FUNCTION 0
SERVO4_FUNCTION 77
SERVO5_FUNCTION 77
SERVO6_FUNCTION 78
SERVO7_FUNCTION 78
SERVO8_FUNCTION 33
SERVO9_FUNCTION 34
SERVO10_FUNCTION 190
SERVO11_FUNCTION 191
SERVO12_FUNCTION 0
SERVO13_FUNCTION 41

# TILT1 (SERVO13: 500=up, 1500=horizontal cruise, 2500=down hover) -> verify props-off!
SERVO13_MIN 1500
SERVO13_MAX 2500
SERVO13_TRIM 2000
SERVO13_REVERSED 1

# Fixed-Wing BWB & Transition (No Airspeed Sensor -> Synthetic Airspeed)
ARSPD_TYPE 0
AIRSPEED_CRUISE 20
AIRSPEED_MIN 13
AIRSPEED_MAX 28
SCALING_SPEED 20
Q_ASSIST_SPEED 11
Q_ASSIST_ANGLE 45
Q_TRANSITION_MS 5000

# --- Calibrated Accel Offsets (Triple LSM6DSV) ---
INS_ACC_ID       4063506
INS_ACCOFFS_X   -0.049967
INS_ACCOFFS_Y   -0.255464
INS_ACCOFFS_Z    0.069623
INS_ACCSCAL_X    0.999995
INS_ACCSCAL_Y    1.003009
INS_ACCSCAL_Z    1.001304

INS_ACC2_ID      4063498
INS_ACC2OFFS_X  -0.037175
INS_ACC2OFFS_Y   0.073859
INS_ACC2OFFS_Z   0.106691
INS_ACC2SCAL_X   1.001637
INS_ACC2SCAL_Y   1.001757
INS_ACC2SCAL_Z   1.002053

INS_ACC3_ID      4063522
INS_ACC3OFFS_X  -0.081698
INS_ACC3OFFS_Y   0.053920
INS_ACC3OFFS_Z  -0.015430
INS_ACC3SCAL_X   1.002053
INS_ACC3SCAL_Y   1.001131
INS_ACC3SCAL_Z   1.010773