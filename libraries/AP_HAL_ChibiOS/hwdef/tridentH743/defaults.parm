# Telemetry on USART2
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 115

# GPS on USART3 (SERIAL2 @ 38400 NMEA)
SERIAL2_PROTOCOL 5
SERIAL2_BAUD 38
GPS1_TYPE 5

# Enable MicroSD File Logging
LOG_BACKEND_TYPE 1

# Carrier link and unused ports quiet
SERIAL3_PROTOCOL -1
SERIAL4_PROTOCOL -1
SERIAL5_PROTOCOL -1
SERIAL6_PROTOCOL -1
BATT_MONITOR 0

